{
  "expo": {
    "name": "Parkaddis",
    "slug": "Parkaddis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkaddis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.captnoah.Parkaddis",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ParkAddis needs your location to find nearby parking and provide navigation.",
        "NSMotionUsageDescription": "Allows the map to rotate according to your device orientation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#064e3b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.captnoah.Parkaddis",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "hardwareAccelerated": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.mapbox.** { *; }\n-keep class org.maplibre.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#064e3b",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "locationWhenInUsePermission": "Show current location on map"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9b6b3ae-e123-4a07-adf5-bdddbb95b8bf"
      }
    },
    "owner": "capt_noah"
  }
}
